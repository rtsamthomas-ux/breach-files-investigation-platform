# The Breach Files - Supabase Configuration
#
# Client-side safe variables (exposed to browser via VITE_)
# Set your active Supabase project URL (from Supabase Dashboard -> Project Settings -> API):
VITE_SUPABASE_URL=https://iqhskbtavksjxrvyyriz.supabase.co

# Modern publishable key (starts with sb_publishable_) or legacy anon key (starts with eyJ...):
# From Supabase Dashboard -> Project Settings -> API (or API Keys):
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-placeholder
# Backward-compatible legacy fallback:
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Server-only secrets (NEVER expose to frontend or prefix with VITE_)
# Modern secret key (starts with sb_secret_) or legacy service_role key (starts with eyJ...):
# Provides administrative bypass privileges for server-side score calculation and verification:
SUPABASE_SECRET_KEY=your-supabase-secret-key-placeholder
# Backward-compatible legacy fallback:
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

